# FTV — fill with the NEW Supabase project. Do not reuse old study keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use anon key (JWT) from Supabase → Settings → API, or the newer publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # alternative to ANON_KEY (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public app URL used when generating referral links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Instagram account username for DM deep links (without @)
NEXT_PUBLIC_INSTAGRAM_USERNAME=YOUR_INSTAGRAM_USERNAME

# WhatsApp business number for respondent verification DMs (country code + number, digits only)
NEXT_PUBLIC_WHATSAPP_NUMBER=YOUR_WHATSAPP_NUMBER
